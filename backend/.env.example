# ==============================================================================
# ERP (FSD) Backend Environment Configuration Example
# Copy this file to .env and configure real credentials for your environment.
# NEVER commit or share populated .env files with real credentials!
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# CORS Allowed Origins (Comma-separated list of trusted frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Reverse Proxy Trust (1 or true when behind ingress / reverse proxy like Nginx or cloud load balancer)
TRUST_PROXY=1

# Evaluation / Demo Mode (Set to true to enable prefilled login credentials and demo fallback passwords)
DEMO_MODE=false

# Database Role Marker (Must be 'erp' for ERP backend)
APP_DB_ROLE=erp

# MongoDB Connection URI
# Local: mongodb://localhost:27017/student_dropout_erp
# Production: mongodb+srv://<user>:<password>@cluster.mongodb.net/student_dropout_erp?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/student_dropout_erp

# JWT Authentication Secret (Required - Min 32 chars, must not use default placeholders)
# Generate a cryptographically secure random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_jwt_secret_at_least_32_characters

# OTP HMAC Secret (Optional - If unset, defaults to JWT_SECRET. Must be >= 32 chars in production)
OTP_HMAC_SECRET=replace_with_a_long_random_otp_secret_at_least_32_characters

# ERP Service-to-Service Ingestion API Key (Required - Min 32 chars)
# Used to authenticate incoming delivery calls from AI service (POST /api/integrations/meeting-requests)
# Must match ERP_SERVICE_API_KEY in the AI Dropout Prediction backend
ERP_SERVICE_API_KEY=replace_with_shared_erp_service_api_key_at_least_32_chars

# Standalone AI Early-Warning Service Integration
AI_SERVICE_BASE_URL=http://localhost:5001
AI_SERVICE_API_KEY=replace_with_shared_ai_service_api_key_at_least_32_chars

# Optional Demo / Seed User Password (if unset, seedDb generates random passwords)
DEMO_PASSWORD=ChangeMeInDev123!

# OTP Authentication Configuration
OTP_ENABLED=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_RESENDS=3
DEMO_SHARED_EMAIL=grouppresentation785@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
EMAIL_DRY_RUN=false

# Notification Dispatcher (n8n & Email Automation)
NOTIFY_TRANSPORT=n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/insighterp-notify
N8N_WEBHOOK_SECRET=
NOTIFY_FALLBACK_SMTP=true

