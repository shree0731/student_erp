{
  "name": "InsightERP Notification Dispatcher",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "insighterp-notify",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Webhook Ingestion",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "webhookId": "insighterp-notify"
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.body.event_type }}",
        "rules": {
          "rules": [
            {
              "value2": "parent_alert"
            },
            {
              "value2": "meeting_request_created"
            },
            {
              "value2": "meeting_status_changed"
            },
            {
              "value2": "mentor_alert"
            },
            {
              "value2": "risk_high_detected"
            }
          ]
        }
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Switch on Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_USER || 'no-reply@insighterp.edu' }}",
        "toEmail": "={{ $('Webhook Ingestion').item.json.body.recipient }}",
        "subject": "={{ $('Webhook Ingestion').item.json.body.subject }}",
        "text": "={{ $('Webhook Ingestion').item.json.body.body_text }}",
        "options": {}
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        740,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"sent\",\n  \"event_id\": \"{{ $('Webhook Ingestion').item.json.body.event_id }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        980,
        300
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook Ingestion": {
      "main": [
        [
          {
            "node": "Switch on Event Type",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Switch on Event Type": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
  "id": "insighterp-notify-workflow",
  "tags": []
}
