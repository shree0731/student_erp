# Production ERP Backend API URL (Leave unset if served by reverse proxy at /api)
VITE_API_BASE_URL=https://erp.yourdomain.edu/api

# Standalone AI Early-Warning Portal URL
VITE_AI_PORTAL_URL=https://ai.yourdomain.edu

# Demo Mode (Disable demo prefill and evaluation shortcuts in production; default: false)
VITE_DEMO_MODE=false
